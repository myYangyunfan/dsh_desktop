{
  "name": "dsh-easyrewrite",
  "version": "3.0.1",
  "description": "The most seamless message recall & re-edit plugin for DSH Web — native experience, strong compatibility, simple toggles, rich settings, modern lightweight UI.",
  "icon": "./assets/icon.png",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./bubble": "./lib/row.js",
    "./recall": "./lib/row.js",
    "./history": "./lib/row.js",
    "./other": "./lib/row.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*": "./locales/bundle/*",
    "./bubble/locale/*": "./locales/bubble/*",
    "./recall/locale/*": "./locales/recall/*",
    "./history/locale/*": "./locales/history/*",
    "./other/locale/*": "./locales/other/*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "slots",
        "sessions",
        "workspaces",
        "conversation",
        "uiConversation",
        "locale",
        "modelDirectories"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "locales",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "README.ja.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "client-plugin",
    "ui",
    "plugin",
    "edit",
    "rewrite",
    "bubble-edit",
    "recall",
    "undo",
    "rollback",
    "version-pager",
    "撤回",
    "气泡编辑",
    "重编辑",
    "取り消し",
    "バブル編集",
    "編集",
    "i18n",
    "internationalization",
    "multilingual",
    "localization",
    "zh",
    "en",
    "ja"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node tests/check-scope-vars.mjs && node tests/smoke-host.mjs && node tests/test-log-memory.mjs && node tests/test-issue9-anti-double-submit.mjs && node tests/test-issue11-bubble-compatibility.mjs && node tests/test-dsh-0.1.7-pager.mjs && node tests/test-dsh-0.1.7-image-drafts.mjs && node tests/test-recall-cross-session-images.mjs && node tests/test-v3-components-render.mjs && node tests/test-vault-storage.mjs && node tests/test-community-improvements.mjs",
    "build": "node build.mjs",
    "prepare": "node build.mjs",
    "prepack": "node build.mjs"
  },
  "devDependencies": {
    "acorn": "^8.18.0",
    "esbuild": "^0.25.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Renzic-Stone/DSH-EasyRewrite.git"
  }
}
