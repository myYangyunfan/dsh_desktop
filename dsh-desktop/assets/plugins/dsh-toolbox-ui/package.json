{
  "name": "dsh-toolbox-ui",
  "version": "1.10.1",
  "description": "Responsive MCP management UI and skills manager for DeepSeek Harness Web — floating panel, JSON import, profile-backed Host Remote management, and a skill market with a hard license gate.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Imzl-zl/dsh-toolbox-ui.git"
  },
  "homepage": "https://github.com/Imzl-zl/dsh-toolbox-ui#readme",
  "bugs": {
    "url": "https://github.com/Imzl-zl/dsh-toolbox-ui/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "node --test --test-timeout=60000",
    "contract:write": "node scripts/rpc-contract.mjs --write",
    "contract:check": "node scripts/rpc-contract.mjs --check",
    "client:write": "node scripts/build-client.mjs --write",
    "client:check": "node scripts/build-client.mjs --check"
  },
  "exports": {
    "./typert": "./lib/typert.js",
    "./client": "./lib/client.js",
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "!lib/client",
    "docs/*.md",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dependencies": {
    "smol-toml": "^1.8.0",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5 <4.2.0",
    "@deepseek-ai/cordis-plugin-loader": ">=1.0.6 <1.2.0",
    "@deepseek-ai/dsh-agent": ">=0.2.1-rc.5 <0.3.0",
    "@deepseek-ai/dsh-agent-loop": ">=0.2.1-rc.5 <0.3.0",
    "@deepseek-ai/dsh-app-boot": ">=0.2.1-rc.5 <0.3.0",
    "@deepseek-ai/dsh-atomic-write": ">=0.2.1-rc.5 <0.3.0",
    "@deepseek-ai/dsh-mcp-client": ">=0.2.1-rc.5 <0.3.0",
    "@deepseek-ai/dsh-scope": ">=0.2.1-rc.5 <0.3.0",
    "@deepseek-ai/dsh-skill": ">=0.2.1-rc.5 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.5 <0.3.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.1-rc.5 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/cordis-plugin-include": "1.0.10",
    "@deepseek-ai/cordis-plugin-loader": "~1.0.6",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.5",
    "@deepseek-ai/dsh-agent-loop": "0.2.1-rc.5",
    "@deepseek-ai/dsh-api-gateway": "0.2.1-rc.5",
    "@deepseek-ai/dsh-app-boot": "0.2.1-rc.5",
    "@deepseek-ai/dsh-atomic-write": "0.2.1-rc.5",
    "@deepseek-ai/dsh-mcp-client": "0.2.1-rc.5",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.5",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.5",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@deepseek-ai/dsh-typert-loader": "0.2.1-rc.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "mcp",
    "skills",
    "skill-manager",
    "agent-skills"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  }
}
