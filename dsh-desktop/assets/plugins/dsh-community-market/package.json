{
  "name": "dsh-community-market",
  "version": "0.1.1",
  "private": true,
  "description": "DSH Desktop built-in community plugin market (upstream: anywhere-labs/deepseek-harness-desktop, MIT): open catalog sources (DSH 1024Store / dshfind / standard HTTP), search, verified npm installs, enable/disable and receipts. · DSH Desktop 内置可视化插件市场：开放目录源、搜索、校验安装与启停管理。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anywhere-labs/deepseek-harness-desktop.git",
    "directory": "dsh-community-market"
  },
  "keywords": [
    "deepseek",
    "dsh",
    "plugin",
    "marketplace",
    "community"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "external": [
        "@deepseek-ai/dsh-client-store"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "semver": "^7.7.3",
    "sharp": "0.35.3",
    "yaml": "^2.9.0"
  }
}
