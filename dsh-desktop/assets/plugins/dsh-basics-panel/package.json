{
  "name": "dsh-basics-panel",
  "version": "0.1.0",
  "private": true,
  "description": "DSH Desktop built-in basics panel (upstream: yxsj245/dsh-Basics-Panel, MIT): a native Settings panel for visualizing and managing MCP servers, skills and rules with a modular feature registry. · DSH Desktop 内置基础能力面板：可视化并管理 MCP 服务器、技能与规则（含空态「新建」入口）。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "external": [],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-home-paths": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.0",
    "cordis": "^4.0.0-rc.7"
  },
  "peerDependenciesMeta": {
    "cordis": {
      "optional": true
    }
  },
  "dependencies": {
    "yaml": "^2.5.0"
  }
}
