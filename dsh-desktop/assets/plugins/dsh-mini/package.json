{
  "name": "@deepseek-ai/dsh-mini",
  "version": "1.4.2",
  "description": "DSH-Mobile — phone bridge for DeepSeek Harness Desktop (Codex-Mini style): drive DSH agent sessions from a phone browser / app, with attachments, per-session model switching, balance ring and LAN gateway QR pairing",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "public",
    "gui",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "bash scripts/build.sh",
    "pack": "bash scripts/build.sh && npm pack"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "platform": "web",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-settings": "*"
  },
  "keywords": [
    "dsh",
    "deepseek",
    "harness",
    "phone",
    "bridge",
    "codex-mini",
    "mobile",
    "gateway",
    "qr"
  ]
}
