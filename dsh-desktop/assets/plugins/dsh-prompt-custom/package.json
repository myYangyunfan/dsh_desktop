{
  "name": "@deepseek-ai/dsh-prompt-custom",
  "version": "0.3.5",
  "description": "自定义 System Prompt：覆盖或追加 DeepSeek Harness 官方默认系统提示词（独立移植版，不依赖内核 settings API）",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "entry": "client",
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.0-rc.6 <2",
    "@deepseek-ai/dsh": ">=0.1.0-rc.6 <2",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.0-rc.6 <2"
  },
  "files": [
    "LICENSE",
    "cordis.patch.yml",
    "lib"
  ]
}
