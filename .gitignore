# Dependencies
dsh-desktop/node_modules/

# Build artifacts
dsh-desktop/dist/

# Runtime vendor (node.exe + npm, generated by fetch-runtime).
# NOTE: dsh-desktop/vendor/dsh-kernel/ holds the pinned vendored dsh kernel
# tarballs (version per scripts/compat/kernel-pin.json) and MUST be tracked; only the runtime subdirs are ignored here.
dsh-desktop/vendor/node/
dsh-desktop/vendor/npm/

# Runtime cache & dev data
.dev-data/
.update-test/


# Logs
*.log
dsh-desktop/data/

# OS
.DS_Store
Thumbs.db

# Temp & updater artifacts
*.tmp
updates/

# Dev diagnostic scripts (not for open source)
_cdp.js
scripts-scan-slots.js
_float-diag.js

# Personal / internal (not for open source)
支付二维码/
.trae/
.zcode/


# 临时脚本/日志（CI/调试产物，防止再堆积）
.tmp-*
_*.js
_*.diff
.qoder/

# RV5 终检追加（2026-08-22）：本地调试/上传暂存目录，不入库
.g-up4/
.g52/
.gitee-upload/
target-s1/
*.exe

# 本地便携版安装/运行目录（DSH Desktop.exe + resources，运行时产物不入库）
portable/

# 内核升级过程旧版 tgz 暂存（alpha.4 激活时遗留，确认稳定后可整体删除）
dsh-desktop/vendor-next/

# 本地便携 LITE 组装目录（构建脚本产物，不入库）
portable-lite/

# 密钥与本地凭据。不要把证书、私钥、.env 推进公开仓库。
# 模式按文件名，避免误伤 vendor tarball（例如 dsh-credentials-*.tgz）和插件源码。
.env
.env.*
!.env.example
*.key
*.p12
*.pfx
*.p8
*.pem
*.cer
*.crt
*.jks
*.keystore
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
id_ecdsa
id_ecdsa.pub
credentials.json
credentials.yaml
credentials.yml
.credentials.yaml
.credentials.yml
secrets.json
service-account.json
service-account*.json
*.mobileprovision
AuthKey_*.p8

# 下面两份是 localhost 测试夹具，不是生产密钥，必须继续入库。
# 仅用于 dsh-desktop/scripts/test/fixtures/（test-key.pem / test-cert.pem）。
!dsh-desktop/scripts/test/fixtures/test-key.pem
!dsh-desktop/scripts/test/fixtures/test-cert.pem
